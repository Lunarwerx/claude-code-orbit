{
  "name": "claude-code-orbit",
  "displayName": "Claude Code Orbit",
  "description": "Power-up for Claude Code: pin, archive, filter, search, and YOLO mode.",
  "version": "1.2.5",
  "publisher": "LunarWerx",
  "license": "MIT",
  "icon": "media/claude-code-orbit.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lunarwerx/claude-code-orbit"
  },
  "bugs": {
    "url": "https://github.com/Lunarwerx/claude-code-orbit/issues"
  },
  "homepage": "https://github.com/Lunarwerx/claude-code-orbit#readme",
  "keywords": ["claude", "claude-code", "anthropic", "sessions", "yolo", "patch", "ai"],
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": ["Other"],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Claude Code Orbit",
      "properties": {
        "claudeCodeOrbit.devMode": {
          "type": "boolean",
          "default": false,
          "description": "Developer mode: uses the bundled patcher instead of fetching from GitHub. Poll interval reduced to 60s for rapid testing. Enable this when testing patcher changes locally."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeCodeOrbit",
          "title": "Claude Code Orbit",
          "icon": "media/claude-code-orbit.png"
        }
      ]
    },
    "views": {
      "claudeCodeOrbit": [
        {
          "type": "webview",
          "id": "claudeCodeOrbit.sidebar",
          "name": "Claude Code Orbit",
          "icon": "media/claude-code-orbit.png"
        }
      ]
    }
  }
}
