# SayDeploy-managed .gitignore — keeps secrets and build artifacts out of git
.env
.env.*
*.env
credentials.toml
credentials.toml.enc
*.secret
*.secrets
*.key
*.pem
*.p12
*.pfx
*.keystore
.secrets
secrets/
config/secrets.yml
config/secrets.yaml
config/database.yml
config/master.key
node_modules/
__pycache__/
*.pyc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/
.next/
.nuxt/
out/
*.vsix
# ...but DO keep the numbered wrapper builds + the build log visible. The build
# NUMBER in the filename is how we know a build actually happened and which is
# newest. (The huge upstream Claude Code .vsix files stay ignored.)
!builds/claude-code-orbit-build-*.vsix
!builds/BUILD_LOG.md
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
*.log
logs/
monitoring/system-health/
# Internal operating playbook — kept locally, NEVER published (this repo is public).
docs/guides/

# Internal-only docs & local workspace state — kept locally, NOT published to the
# public repo. (Untracked via `git rm --cached`; the working copies stay on disk.)
JUSTIFY_EXISTENCE.md
RELEASE_RULES.md
LAUNCHER_SYNC.md
ORBIT_KIT.md
CLAUDE.md
docs/CODEX_LAUNCHER_PROMPT.md
.vscode/paramount.json
